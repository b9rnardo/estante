{
  "name": "estante",
  "productName": "Estante",
  "version": "0.1.0",
  "description": "Leitor de e-books minimalista que busca EPUBs e PDFs em acervos abertos",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/index.js",
    "app": "electron .",
    "dist": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "ios": "node mobile/build.mjs && cap sync ios",
    "ipa": "npm run ios && node mobile/ipa.mjs",
    "source": "node mobile/source.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "license": "MIT",
  "dependencies": {
    "epubjs": "^0.3.93",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/file-transfer": "^2.0.6",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "local.estante.app",
    "productName": "Estante",
    "files": [
      "electron/**",
      "server/**",
      "public/**",
      "package.json",
      "!node_modules/@napi-rs/**"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.books",
      "target": "dmg",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Estante"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signExecutable": false
    }
  }
}
